# cp .env.example .env 후 값을 채워 사용한다. pydantic-settings가 FAIND_ 접두사로 읽는다.

FAIND_BACKEND_BASE_URL=http://localhost:8080
FAIND_BACKEND_SERVICE_TOKEN=
FAIND_CAMERA_ALLOWED_HOSTS=

FAIND_PUBLIC_DATA_BASE_URL=https://apis.data.go.kr
FAIND_PUBLIC_DATA_SERVICE_KEY=

# none | anthropic
FAIND_LLM_PROVIDER=none
FAIND_ANTHROPIC_API_KEY=
FAIND_LLM_MODEL=claude-sonnet-5

# 화재/연기로 파인튜닝된 YOLOv8 가중치 경로. 없으면 화재감지는 항상 "미검출"을 반환한다.
# (저장소에 이미 MIT+CC BY 4.0 라이선스 모델이 이 경로에 포함되어 있다 — models/NOTICE.md 참조)
FAIND_YOLO_MODEL_PATH=models/fire_yolov8.pt
FAIND_YOLO_DEVICE=cpu
FAIND_FIRE_CONFIDENCE_THRESHOLD=0.55

# 깜빡임 기반 오탐 필터용 - CCTV 폴링 1회당 짧게 연속 촬영하는 프레임 수/간격(초)
FAIND_FIRE_BURST_FRAME_COUNT=5
FAIND_FIRE_BURST_INTERVAL_SECONDS=0.15

FAIND_CCTV_POLLING_ENABLED=false
FAIND_CCTV_POLL_INTERVAL_SECONDS=30
FAIND_CCTV_CAMERAS=[]

FAIND_CORS_ALLOWED_ORIGINS=http://localhost:8080
