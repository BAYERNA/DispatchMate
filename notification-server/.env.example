PORT=3001
BACKEND_BASE_URL=http://localhost:8080

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=faind
DB_PASSWORD=
DB_NAME=faind

# backend(Java)의 faind.jwt.secret과 반드시 같은 값이어야 한다 — 두 서비스가 같은 서명키로
# JWT를 신뢰한다.
JWT_SECRET=

# backend가 이 서버의 /webhook/* 호출 시 전달하는 동일한 토큰. 비워두면 503으로 거부한다.
INTERNAL_WEBHOOK_TOKEN=

# 선택 연동. URL이 비어 있으면 성공으로 가장하지 않고 UNAVAILABLE/FAILED로 기록한다.
SMS_GATEWAY_URL=
VOICE_GATEWAY_URL=
MULTICHANNEL_TOKEN=
INTERAGENCY_WEBHOOK_URL=
INTERAGENCY_TOKEN=
PUSH_GATEWAY_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=dispatchmate-notification-server

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:5174,http://localhost:5175
